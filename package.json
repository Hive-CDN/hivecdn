{
  "name": "hivecdn",
  "version": "2.4.1",
  "private": true,
  "description": "HiveCDN — high-performance distributed content delivery platform",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "release:sdk": "cd packages/sdk && npm publish --access public",
    "release:cli": "cd packages/cli && npm publish --access public"
  },
  "engines": { "node": ">=18.0.0" },
  "devDependencies": {
    "turbo": "^1.13.4",
    "typescript": "^5.4.5",
    "@types/node": "^20.14.2",
    "eslint": "^9.5.0",
    "vitest": "^1.6.0",
    "prettier": "^3.3.2"
  }
}